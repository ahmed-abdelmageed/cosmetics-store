generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(USER)
  orders    Order[]
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  nameEn   String
  nameAr   String
  slug     String    @unique
  products Product[]
}

model Product {
  id                 String      @id @default(cuid())
  nameEn             String
  nameAr             String
  slug               String      @unique
  descriptionEn      String
  descriptionAr      String
  price              Float
  discountPercent    Int         @default(0)
  discountActive     Boolean     @default(false)
  stock              Int         @default(0)
  images              String[]
  categoryId         String?
  category           Category?   @relation(fields: [categoryId], references: [id])
  gender             Gender      @default(UNISEX)
  featured           Boolean     @default(false)
  orderItems         OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Slide {
  id          String   @id @default(cuid())
  titleEn     String
  titleAr     String
  subtitleEn  String?
  subtitleAr  String?
  image       String
  link        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  items         OrderItem[]
  total         Float
  status        OrderStatus @default(PENDING)
  fullName      String
  phone         String
  address       String
  city          String
  notes         String?
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  name       String
  price      Float
  quantity   Int
  image      String?
}
